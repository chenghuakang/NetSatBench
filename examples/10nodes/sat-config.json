{
  "node-config-common": [
    {
      "match-key": "type",
      "match-value": "satellite",
      "config-common": {
        "type": "undefined",
        "n_antennas": 2,
        "metadata": {},
        "image": "msvcbench/sat-container:latest",
        "sidecars": [],
        "cpu-request": "100m",
        "mem-request": "200MiB",
        "cpu-limit": "200m",
        "mem-limit": "400MiB",
        "L3-config": {
          "enable-netem": true,
          "enable-routing": true,
          "routing-module": "extra.routing.isis",
          "routing-metadata": {
            "isis-area-id": "0001",
            "advertize-default-route": false
          },
          "auto-assign-ips": true,
          "auto-assign-super-cidr": [
            {
              "match-key": "type",
              "match-value": "satellite",
              "super-cidr": "172.20.100.0/24"
            }
          ]
        }
      }
    },
    {
      "match-key": "type",
      "match-value": "gateway",
      "config-common": {
        "type": "undefined",
        "n_antennas": 2,
        "metadata": {},
        "image": "msvcbench/sat-container:latest",
        "sidecars": [],
        "cpu-request": "100m",
        "mem-request": "200MiB",
        "cpu-limit": "200m",
        "mem-limit": "400MiB",
        "L3-config": {
          "enable-netem": true,
          "enable-routing": true,
          "routing-module": "extra.routing.isis",
          "routing-metadata": {
            "isis-area-id": "0001",
            "advertize-default-route": false
          },
          "auto-assign-ips": true,
          "auto-assign-super-cidr": [
            {
              "match-key": "type",
              "match-value": "gateway",
              "super-cidr": "172.20.101.0/24"
            }
          ]
        }
      }
    },
    {
      "match-key": "type",
      "match-value": "user",
      "config-common": {
        "type": "undefined",
        "n_antennas": 2,
        "metadata": {},
        "image": "msvcbench/sat-container:latest",
        "sidecars": [],
        "cpu-request": "100m",
        "mem-request": "200MiB",
        "cpu-limit": "200m",
        "mem-limit": "400MiB",
        "L3-config": {
          "enable-netem": true,
          "enable-routing": true,
          "routing-module": "extra.routing.isis",
          "routing-metadata": {
            "isis-area-id": "0001",
            "advertize-default-route": false
          },
          "auto-assign-ips": true,
          "auto-assign-super-cidr": [
            {
              "match-key": "type",
              "match-value": "user",
              "super-cidr": "172.20.102.0/24"
            }
          ]
        }
      }
    }
  ],
  "epoch-config": {
    "epoch-dir": "examples/10nodes/epochs",
    "file-pattern": "NetSatBench-epoch*.json"
  },
  "nodes": {
    "sat1": {
      "type": "satellite",
      "metadata": {
        "sat_config": {
          "sat_orbit": 1,
          "sat_num_in_orbit": 1
        },
        "shell": "shell1",
        "shell_config": {
          "altitude": 1200,
          "orbit_cycle": 6556,
          "inclination": 87.9,
          "phase_shift": 0,
          "number_of_orbit": 12,
          "number_of_satellite_per_orbit": 49
        }
      }
    },
    "grd1": {
      "type": "gateway",
      "n_antennas": 2,
      "cpu-request": "200m",
      "mem-request": "400MiB",
      "cpu-limit": "400m",
      "mem-limit": "800MiB",
      "metadata": {
        "location": {
          "latitude": -37.4275,
          "longitude": 57.5806,
          "altitude": 30
        },
        "labels": {
          "name": "180 degree opposite of user1"
        }
      },
      "L3-config": {
        "routing-metadata": {
          "advertize-default-route": true
        }
      }
    },
    "usr1": {
      "type": "user",
      "n_antennas": 2,
      "metadata": {
        "location": {
          "latitude": 37.7749,
          "longitude": -122.4194,
          "altitude": 20
        },
        "labels": {
          "name": "san_francisco_user"
        }
      }
    }
  }
}
