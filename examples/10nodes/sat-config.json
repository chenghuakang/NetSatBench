{
  "node-config-common":[
    {
      "match-key": "type",
      "match-value": "satellite",
      "config-common": {
        "type": "undefined",
        "n_antennas": 1,
        "metadata": {
          "link_bandwidth_Gbps": 5,
          "link_loss_percent": 0,
          "satellite_link_type": "Grid",
          "link_policy": "LeastDelay",
          "ip_version": "IPv4",
          "deploy_machines":[
            {
              "IP": "192.168.248.30",
              "port": 22,
              "username": "root",
              "password": "cheng2704"
            }
          ]
        },
        "image": "msvcbench/sat-container:latest",
        "sidecars":[],
        "cpu-request": "100m",
        "mem-request": "200MiB",
        "cpu-limit": "200m",
        "mem-limit": "400MiB",
        "L3-config": {
          "enable-netem": true,
          "enable-routing": true,
          "routing-module": "extra.routing.isis",
          "routing-metadata": {
            "isis-area-id": "0001",
            "advertize-default-route": false
          },
          "auto-assign-ips": true,
          "auto-assign-super-cidr":[
            {
              "match-key": "type",
              "match-value": "satellite",
              "super-cidr": "172.100.0.0/16"
            }
          ]
        }
      }
    },
